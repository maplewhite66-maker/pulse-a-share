PULSE_PORT=8765
PULSE_ACCESS=local
PULSE_SCHEDULER=0
PULSE_EM_INTERVAL=1.6
# Directory for authorized ground-volume point-in-time input batches.
# PULSE_GROUND_VOLUME_DIR=/data/ground-volume-input
# Authorized, point-in-time disclosures, historical replay and live strategy inputs.
# PULSE_ADVANCED_DATA_DIR=/data/pulse-v4
# Set to 1 for board collection even when nobody has the panel open.
PULSE_SECTOR_FLOW=0
# Optional override of PULSE_SCHEDULER for the daily 17:00 post-close seat chart.
# PULSE_LHB_SCHEDULER=1
# Set only with an authorized Fuyao account and confirmed quote-time field.
# PULSE_FUYAO_API_KEY=
# PULSE_FUYAO_QUOTE_TIME_FIELD=
# PULSE_AUCTION_PUBLIC=0
# Cloud values and volume configuration: see README.md
